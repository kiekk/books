  {
   "id": 21,
   "type": "timeseries",
   "title": "Pod CPU usage / limit (near 1 = throttled)",
   "description": "Only pods that have a CPU limit appear",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
