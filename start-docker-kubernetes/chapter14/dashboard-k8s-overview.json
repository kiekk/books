   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace,pod)(rate(container_cpu_usage_seconds_total{container=\"\",pod!=\"\",namespace=~\"$namespace\"}[5m])) / sum by (namespace,pod)(kube_pod_container_resource_limits{resource=\"cpu\",namespace=~\"$namespace\"})",
